# Where the Kindling API lives — the Cloudflare Worker in ./api.
#
# Optional. Without it the site still works end to end; you just don't get an
# account, so ideas live only in this browser. Point it at a deployed Worker to
# turn on accounts and cross-device sync.
#
# Local development against ./api:
#   NEXT_PUBLIC_KINDLING_API=http://127.0.0.1:8787

NEXT_PUBLIC_KINDLING_API=
