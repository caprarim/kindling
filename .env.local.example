# Optional. Kindling runs completely without these — questions, generation,
# saving and the never-repeat guarantee are all local. Fill them in to turn on
# accounts and cross-device sync.
#
# Both values are public by design (the anon key is safe in a browser); the
# database is protected by row level security, see supabase/schema.sql.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
