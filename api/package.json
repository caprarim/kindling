{
  "name": "kindling-api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:create": "wrangler d1 create kindling",
    "db:migrate": "wrangler d1 execute kindling --remote --file=./schema.sql",
    "db:migrate:local": "wrangler d1 execute kindling --local --file=./schema.sql",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260722.1",
    "typescript": "^5.9.2",
    "wrangler": "^4.42.0"
  }
}
